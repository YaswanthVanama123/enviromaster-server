# ============================================================================
# ENVIRONMENT & SERVER CONFIGURATION
# ============================================================================
NODE_ENV=production
# Digital Ocean will use default port 5000 (configure Nginx reverse proxy)
PORT=5002

# ⚠️ DIGITAL OCEAN: Update this with your server IP or domain
# Example: http://your-droplet-ip:5000 OR https://api.enviromasternva.com (with Nginx SSL)
SERVER_URL=https://backend.clicksolver.com/

# ============================================================================
# DATABASE CONFIGURATION (MongoDB Atlas)
# ============================================================================
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/enviro_master?retryWrites=true&w=majority
MONGO_DB=enviro_master

# ----------------------------------------------------------------------------
# BI DATABASE (read-only source for RouteStar customers)
# RouteStar customers are imported from the BI warehouse instead of being
# scraped here — BI already holds them. This server only scrapes MAP DISTANCES.
# Without these vars, POST /sync returns 503.
# A read-only Atlas user is preferred; nothing is ever written to this database.
# BI_TENANT_CODE selects the tenant in bi_tenants (BI is multi-tenant).
# ----------------------------------------------------------------------------
# BI_MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/inventory_db?retryWrites=true&w=majority
# BI_MONGO_DB=inventory_db
# BI_COLLECTION_PREFIX=bi_
# BI_TENANT_CODE=EM-NRV
# BI_MONGO_MAX_POOL=5

# ----------------------------------------------------------------------------
# PUSH TO PRODUCTION (optional)
# Sends one agreement folder from this environment to the production backend,
# which writes it into the production database. No production DB credentials are
# needed here — the transfer goes over the production HTTP API.
#
# SENDER (stage): set PRODUCTION_PUSH_TOKEN to enable the feature. Leave it unset
# to hide it entirely — the API reports not-configured and the button does not
# render.
# RECEIVER (production): set the SAME PRODUCTION_PUSH_TOKEN so it accepts pushes.
# A deployment with the token unset answers 503 to /production-push/ingest.
#
# SELF_API_URL is this deployment's own public API base. When it equals
# PRODUCTION_API_URL the server refuses to push, so production cannot overwrite
# itself with its own records — and the button is hidden there, so production
# can still hold the shared token purely to receive pushes.
# ----------------------------------------------------------------------------
# PRODUCTION_API_URL=https://pdfform.enviromasternva.com/api
# PRODUCTION_PUSH_TOKEN=<long random shared secret, identical on both sides>
# SELF_API_URL=https://stage.enviromasternva.com/api
# PRODUCTION_PUSH_MAX_BODY_MB=64
# PRODUCTION_PUSH_TIMEOUT_MS=120000

# ============================================================================
# PDF SERVICE CONFIGURATION
# ============================================================================
# ⚠️ IMPORTANT: Do NOT include /pdf at the end! The code adds the path automatically.
# CORRECT: http://45.55.208.199:3000
# WRONG: http://45.55.208.199:3000/pdf (causes double /pdf/pdf/ in URL)
PDF_REMOTE_BASE=http://your-pdf-host:3000
PDF_MAX_BODY_MB=5
PDF_REMOTE_TIMEOUT_MS=90000

# ============================================================================
# ZOHO BIGIN INTEGRATION
# ============================================================================
# Client credentials from Zoho API Console (US account — api-console.zoho.com)
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret

# Zoho US data center URLs (bigin.zoho.com account)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
ZOHO_BIGIN_API_URL=https://www.zohoapis.com/bigin/v2
ZOHO_CRM_API_URL=https://www.zohoapis.com/crm/v3

# ⚠️ DIGITAL OCEAN: Update this with your server URL
# Example: http://your-droplet-ip:5000/oauth/callback OR https://api.enviromasternva.com/oauth/callback
# This MUST match the redirect URI in Zoho API Console
ZOHO_REDIRECT_URI=http://localhost:5002/oauth/callback

# Zoho refresh token — regenerate this by visiting /oauth/zoho/auth after updating credentials above
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token

# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================
EMAIL_HOST=enviromasternva.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=no-reply@example.com
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM_NAME=EnviroMaster NVA
EMAIL_FROM_ADDRESS=no-reply@example.com

# ============================================================================
# ELECTRONIC SIGNATURES
# ============================================================================
# Base URL of the web app that serves the public signing page (/sign/<token>).
# ⚠️ This MUST be the origin that serves the React app — NOT the marketing site.
# Pointing it at the WordPress/LiteSpeed host makes every signing link 404.
# When a request arrives from an origin listed in ALLOWED_ORIGINS, that origin is
# used instead, so links created from localhost stay on localhost. This value is
# only the fallback (used for emails sent by background jobs).
SIGNING_PORTAL_URL=https://salesform.enviromasternva.com
# How long an emailed signing link stays valid, in days.
SIGNATURE_TOKEN_TTL_DAYS=30
# Where to send "signer declined" and "fully signed" notices.
# Defaults to EMAIL_FROM_ADDRESS when unset.
SIGNATURE_NOTIFY_EMAIL=no-reply@example.com
# Largest drawn-signature PNG accepted, in bytes.
SIGNATURE_IMAGE_MAX_BYTES=2097152
# How long a customer can view/download their signed copy after signing, in
# minutes. The signing token is destroyed the moment they sign, so this
# short-lived receipt is what keeps the signed PDF on screen (and lets them
# reload the page) without leaving a reusable signing link alive.
SIGNATURE_RECEIPT_TTL_MINUTES=60

# ============================================================================
# MAPBOX CONFIGURATION (Directions & Geocoding API)
# ============================================================================
# Get your access token from: https://account.mapbox.com/access-tokens/
# Used for calculating driving times in Account Type Detector and for reverse
# geocoding the GPS coordinates captured when an agreement is signed.
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
# JWT Secret - Strong random string for token signing
JWT_SECRET=generate_with_openssl_rand_hex_64
JWT_EXPIRES_IN=7d
 
# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# ⚠️ DIGITAL OCEAN: Update this with your frontend URLs
# Production frontend: https://enviromasternva.com
# Multiple origins separated by comma
# For local development, also include: http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=https://salesform.enviromasternva.com,https://enviromasternva.com,http://localhost:5173,http://localhost:3000,https://enviromaster.vercel.app,http://localhost:5174

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=info

# ============================================================================
# ROUTESTAR INTEGRATION
# ============================================================================
ROUTESTAR_BASE_URL=https://emnrv.routestar.online
ROUTESTAR_USERNAME=your_routestar_username
ROUTESTAR_PASSWORD=your_routestar_password

# ============================================================================
# DEPLOYMENT NOTES - Digital Ocean Deployment
# ============================================================================
#
# BEFORE DEPLOYING TO DIGITAL OCEAN:
# 1. ✅ MongoDB Atlas - Already configured correctly
# 2. ✅ Email credentials - Already configured correctly
# 3. ✅ Zoho credentials - Already configured correctly
# 4. ✅ JWT_SECRET - Already generated (strong 128-char secret)
# 5. ⚠️ SERVER_URL - UPDATE with your droplet IP or domain
# 6. ⚠️ ZOHO_REDIRECT_URI - UPDATE to match your server URL
# 7. ✅ ALLOWED_ORIGINS - Set to https://enviromasternva.com (your frontend)
#
# DIGITAL OCEAN DEPLOYMENT STEPS:
# 1. Create Ubuntu droplet (recommended: 2GB RAM, $12/month)
# 2. SSH into droplet: ssh root@your-droplet-ip
# 3. Install Node.js 18 or 20:
#    curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash -
#    sudo apt-get install -y nodejs
# 4. Install PM2 (process manager):
#    sudo npm install -g pm2
# 5. Upload backend code to: /var/www/enviro-backend/
# 6. Install dependencies:
#    cd /var/www/enviro-backend
#    npm install --production
# 7. Copy this .env file to server and update:
#    - SERVER_URL with your droplet IP
#    - ZOHO_REDIRECT_URI with your droplet IP
# 8. Start app with PM2:
#    pm2 start server.js --name enviro-backend
#    pm2 save
#    pm2 startup
# 9. Configure Nginx reverse proxy (optional but recommended):
#    - See DIGITAL_OCEAN_DEPLOYMENT.md for full guide
# 10. Update Zoho API Console redirect URI to match production URL
# 11. Regenerate ZOHO_REFRESH_TOKEN by visiting:
#     http://your-droplet-ip:5000/oauth/zoho/auth
#
# ============================================================================
